# ── Neon ─────────────────────────────────────────────────────────────
# Pooled connection string (Neon dashboard → Connect → "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection string (same, WITHOUT "-pooler") — needed for realtime LISTEN/NOTIFY
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Security ─────────────────────────────────────────────────────────
# Any random string of 32+ characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# ── First owner account (created on first boot if it doesn't exist) ──
ADMIN_EMAIL=owner@crumbandcraft.pk
ADMIN_PASSWORD=change-me-now

# Optional: create demo staff accounts staff.f7@ / staff.saddar@ / staff.bahria@crumbandcraft.pk
# DEMO_STAFF_PASSWORD=demo-staff-pass

PORT=8080
